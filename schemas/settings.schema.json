{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-desk.dev/schemas/settings.json",
  "title": "Settings",
  "type": "object",
  "properties": {
    "notifyEnabled": { "type": "boolean", "default": true },
    "autoConfirmGates": { "type": "boolean", "default": false },
    "defaultAgentId": {
      "type": "string",
      "default": "",
      "description": "Default named agent profile for new tasks"
    },
    "codingAgent": { "type": "string", "default": "claude" },
    "defaultModel": {
      "type": "string",
      "default": "",
      "description": "Default LLM model for new tasks; empty = follow CLI default"
    },
    "workspaceLockEnabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, only one active task per project directory"
    },
    "autoRetryEnabled": {
      "type": "boolean",
      "default": true,
      "description": "Automatically retry failed tasks"
    },
    "maxRetries": {
      "type": "integer",
      "default": 2,
      "minimum": 0,
      "maximum": 10,
      "description": "Maximum auto-retry attempts per task"
    },
    "retryDelaySec": {
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "description": "Seconds to wait before each auto-retry"
    },
    "queueWhenWorkspaceBusy": {
      "type": "boolean",
      "default": true,
      "description": "Queue tasks when the workspace directory is busy"
    },
    "executorMaxConcurrent": {
      "type": "integer",
      "default": 4,
      "minimum": 0,
      "maximum": 32,
      "description": "Max dispatched+running tasks for the in-process local executor; 0 = unlimited"
    },
    "idleTimeoutSec": { "type": "integer", "default": 3600 },
    "awaitingIdleTimeoutSec": { "type": "integer", "default": 86400 },
    "webBaseUrl": { "type": "string", "default": "http://127.0.0.1:19877" },
    "defaultFixWorkflowId": {
      "type": "string",
      "default": "sys-fix-pipeline",
      "description": "Workflow used by bugs AI fix; empty or none = single skill task"
    },
    "defaultWorkflowMode": {
      "type": "string",
      "enum": ["shared", "independent"],
      "default": "shared"
    },
    "providers": {
      "type": "object",
      "properties": {
        "agent": { "type": "string" },
        "issue": { "type": "string" },
        "notify": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dingtalk": {
      "type": "object",
      "properties": {
        "webhook": { "type": "string" },
        "secret": { "type": "string" },
        "keyword": { "type": "string" },
        "appKey": { "type": "string" },
        "appSecret": { "type": "string" },
        "agentId": { "type": "string" },
        "userIds": { "type": "string" },
        "cardTemplateId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "repo": { "type": "string" },
        "owner": { "type": "string" },
        "repoName": { "type": "string" },
        "projectDir": { "type": "string" },
        "apiBase": { "type": "string" }
      },
      "additionalProperties": false
    },
    "notifyWebhook": {
      "type": "object",
      "properties": {
        "url": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

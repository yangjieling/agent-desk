{
  "name": "@agent-desk/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agent-desk": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent-desk": "node ./dist/index.js",
    "tasks:list": "node ./dist/index.js tasks list",
    "tasks:create": "node ./dist/index.js tasks create",
    "web": "node ./dist/index.js web"
  },
  "dependencies": {
    "@agent-desk/core": "workspace:*",
    "@agent-desk/db": "workspace:*",
    "@agent-desk/provider-agent-claude": "workspace:*",
    "@agent-desk/provider-issue-manual": "workspace:*",
    "@agent-desk/provider-notify-webhook": "workspace:*",
    "@agent-desk/runner": "workspace:*",
    "@agent-desk/server": "workspace:*",
    "@agent-desk/workflow": "workspace:*",
    "commander": "^13.1.0"
  },
  "files": ["dist"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-desk.dev/schemas/skill.schema.json",
  "title": "SkillDescriptor",
  "description": "Portable skill catalog entry for agent-desk (SKILL.md frontmatter + body).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "instructions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable kebab-case id"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "instructions": {
      "type": "string",
      "description": "Markdown body after YAML frontmatter"
    },
    "path": { "type": "string" },
    "dir": { "type": ["string", "null"] },
    "source": {
      "type": "string",
      "enum": [
        "project-agent-desk",
        "project-agents",
        "custom",
        "user",
        "bundled"
      ]
    },
    "scripts": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

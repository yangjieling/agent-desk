{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-desk.dev/schemas/workflow.json",
  "title": "Workflow",
  "type": "object",
  "required": ["id", "name", "mode", "nodes"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "mode": { "enum": ["shared", "independent"] },
    "source": { "enum": ["system", "user"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill", "title"],
        "properties": {
          "id": { "type": "string" },
          "skill": { "type": "string" },
          "title": { "type": "string" },
          "prompt": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "createdAt": { "type": "integer" },
    "updatedAt": { "type": "integer" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-desk.dev/schemas/agent.json",
  "title": "AgentProfile",
  "type": "object",
  "required": ["id", "name", "provider", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^a_" },
    "name": { "type": "string", "maxLength": 80 },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "defaultSkill": { "type": "string" },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Extra skill ids mounted with the agent in addition to the task skill"
    },
    "instructions": { "type": "string" },
    "createdAt": { "type": "integer" },
    "updatedAt": { "type": "integer" }
  },
  "additionalProperties": false
}
